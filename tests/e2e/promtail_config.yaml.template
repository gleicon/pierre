server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /var/lib/promtail/positions.yaml

clients:
  - url: http://host.docker.internal:__LOKI_PORT__/loki/api/v1/push

scrape_configs:
  - job_name: synthetic
    static_configs:
      - targets:
          - localhost
        labels:
          job: synthetic-generator
          __path__: /var/log/synthetic/*.log
    pipeline_stages:
      - json:
          expressions:
            level: level
            msg: msg
      - labels:
          level:
